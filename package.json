{
  "name": "netbrowserclaw",
  "version": "0.1.0",
  "description": "开源的浏览器 AI 侧边栏：让任意大模型读取网页、修改样式、批量下载媒体与文档、导出内容，并可通过 MCP 暴露浏览器能力。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/netbrowserclaw.git"
  },
  "keywords": [
    "chrome-extension",
    "edge-extension",
    "manifest-v3",
    "side-panel",
    "ai-assistant",
    "browser-agent",
    "mcp",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "check": "node scripts/check-project.mjs",
    "verify": "node scripts/verify-e2e.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "verify:all": "node scripts/check-project.mjs && node scripts/verify-e2e.mjs && node scripts/verify-mcp.mjs",
    "companion": "node companion/server.mjs",
    "companion:mcp": "node companion/server.mjs --mcp",
    "diag:bridge": "node scripts/diag-bridge.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
